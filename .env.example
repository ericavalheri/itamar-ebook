# Senha de acesso ao painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do painel admin.
# Gere um valor aleatório longo, por exemplo com: openssl rand -hex 32
ADMIN_SESSION_SECRET=troque-este-segredo

# Preço do e-book em centavos (ex.: 2990 = R$ 29,90)
EBOOK_PRICE_CENTAVOS=2990

# --- Asaas (gateway de pagamento Pix) ---
# Chave de API do Asaas (Configurações > Integrações > Chaves de API).
# Use uma chave de sandbox para testar antes de trocar para produção.
ASAAS_API_KEY=

# "sandbox" (padrão, para testes) ou "production" (dinheiro de verdade)
ASAAS_ENV=sandbox

# Token que o Asaas envia no cabeçalho "asaas-access-token" de cada webhook.
# Defina o MESMO valor aqui e no cadastro do webhook no painel do Asaas
# (Configurações > Integrações > Webhooks > Token de autenticação).
# Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Diretório onde o arquivo SQLite é gravado (opcional, padrão: ./data)
# DATA_DIR=/caminho/persistente/data
